{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AST-SAST",
          "version": "1.0.0",
          "informationUri": "https://example.org/ast-sast",
          "rules": [
            {
              "id": "SAST-SECRET-001",
              "name": "Hardcodedcredential",
              "shortDescription": {
                "text": "Hardcoded credential"
              },
              "fullDescription": {
                "text": "Store secrets outside source code: use environment variables, a secret manager (Vault, AWS Secrets Manager) or an encrypted .env file excluded from version control."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html",
              "properties": {
                "cwe": "CWE-798",
                "severity": "MEDIUM"
              }
            },
            {
              "id": "SAST-RCE-001",
              "name": "Arbitrarycodeexecution",
              "shortDescription": {
                "text": "Arbitrary code execution"
              },
              "fullDescription": {
                "text": "Avoid eval/exec on untrusted input. Use a dispatch dictionary of callables or ast.literal_eval for safe literal parsing."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/95.html",
              "properties": {
                "cwe": "CWE-95",
                "severity": "CRITICAL"
              }
            },
            {
              "id": "SAST-SQLI-001",
              "name": "SQLinjectionviadynamicquery",
              "shortDescription": {
                "text": "SQL injection via dynamic query"
              },
              "fullDescription": {
                "text": "Use parameterised queries (placeholders) instead of f-strings, string concatenation or .format(). Example: cursor.execute('SELECT * FROM users WHERE id = ?', (user_id,))."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/89.html",
              "properties": {
                "cwe": "CWE-89",
                "severity": "HIGH"
              }
            },
            {
              "id": "SAST-XSS-001",
              "name": "PossibleCross-SiteScripting",
              "shortDescription": {
                "text": "Possible Cross-Site Scripting"
              },
              "fullDescription": {
                "text": "Do not return raw HTML built from user input. Rely on the templating engine's contextual auto-escaping (Jinja autoescape, Django's escape filter) and never mark user-controlled strings as 'safe'."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/79.html",
              "properties": {
                "cwe": "CWE-79",
                "severity": "HIGH"
              }
            },
            {
              "id": "SAST-SSTI-001",
              "name": "Server-SideTemplateInjection",
              "shortDescription": {
                "text": "Server-Side Template Injection"
              },
              "fullDescription": {
                "text": "Never compile a template from user input. Render fixed template files and pass user data only as render context variables. If dynamic content is required, sandbox the environment (jinja2.sandbox.SandboxedEnvironment) and restrict globals."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/1336.html",
              "properties": {
                "cwe": "CWE-1336",
                "severity": "CRITICAL"
              }
            },
            {
              "id": "SAST-CMDI-001",
              "name": "OScommandinjection",
              "shortDescription": {
                "text": "OS command injection"
              },
              "fullDescription": {
                "text": "Pass arguments as a list and keep shell=False (the default). When a shell is unavoidable, sanitize input with shlex.quote() and validate against an allow-list of expected values."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/78.html",
              "properties": {
                "cwe": "CWE-78",
                "severity": "CRITICAL"
              }
            },
            {
              "id": "SAST-DESERIAL-001",
              "name": "Insecuredeserialization",
              "shortDescription": {
                "text": "Insecure deserialization"
              },
              "fullDescription": {
                "text": "Never deserialize data from untrusted sources with pickle/marshal/shelve. Prefer JSON for data exchange; for YAML always use yaml.safe_load() (never plain yaml.load() without SafeLoader)."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/502.html",
              "properties": {
                "cwe": "CWE-502",
                "severity": "CRITICAL"
              }
            },
            {
              "id": "SAST-XXE-001",
              "name": "XMLExternalEntityexpansion",
              "shortDescription": {
                "text": "XML External Entity expansion"
              },
              "fullDescription": {
                "text": "Replace stdlib XML parsers with the defusedxml package when parsing untrusted input. For lxml, instantiate XMLParser with resolve_entities=False and no_network=True."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/611.html",
              "properties": {
                "cwe": "CWE-611",
                "severity": "HIGH"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SAST-SECRET-001",
          "level": "warning",
          "message": {
            "text": "Hardcoded secret in variable \"API_KEY\"."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_vuln_app.py"
                },
                "region": {
                  "startLine": 16,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "cwe": "CWE-798",
            "confidence": "HIGH",
            "snippet": "API_KEY = \"EXAMPLE_FAKE_KEY_DO_NOT_USE_THIS_VALUE_1\""
          }
        },
        {
          "ruleId": "SAST-SECRET-001",
          "level": "warning",
          "message": {
            "text": "Hardcoded secret in variable \"DATABASE_PASSWORD\"."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_vuln_app.py"
                },
                "region": {
                  "startLine": 17,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "cwe": "CWE-798",
            "confidence": "HIGH",
            "snippet": "DATABASE_PASSWORD = \"EXAMPLE_FAKE_PASSWORD_DO_NOT_USE_THIS_2\""
          }
        },
        {
          "ruleId": "SAST-RCE-001",
          "level": "error",
          "message": {
            "text": "Call to dangerous builtin eval() enables arbitrary code execution."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_vuln_app.py"
                },
                "region": {
                  "startLine": 23,
                  "startColumn": 16
                }
              }
            }
          ],
          "properties": {
            "cwe": "CWE-95",
            "confidence": "HIGH",
            "snippet": "return str(eval(expr))"
          }
        },
        {
          "ruleId": "SAST-SQLI-001",
          "level": "error",
          "message": {
            "text": "Dynamically constructed SQL query (f-string). Parameterise the query to prevent injection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_vuln_app.py"
                },
                "region": {
                  "startLine": 31,
                  "startColumn": 5
                }
              }
            }
          ],
          "properties": {
            "cwe": "CWE-89",
            "confidence": "HIGH",
            "snippet": "cursor.execute(f\"SELECT * FROM users WHERE name = '{name}'\")"
          }
        },
        {
          "ruleId": "SAST-XSS-001",
          "level": "error",
          "message": {
            "text": "Call to render_template_string() with possibly untrusted content may inject HTML/JS into the response."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_vuln_app.py"
                },
                "region": {
                  "startLine": 38,
                  "startColumn": 12
                }
              }
            }
          ],
          "properties": {
            "cwe": "CWE-79",
            "confidence": "HIGH",
            "snippet": "return render_template_string(\"<h1>Hello \" + name + \"</h1>\")"
          }
        },
        {
          "ruleId": "SAST-XSS-001",
          "level": "error",
          "message": {
            "text": "Call to Markup() with possibly untrusted content may inject HTML/JS into the response."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_vuln_app.py"
                },
                "region": {
                  "startLine": 42,
                  "startColumn": 12
                }
              }
            }
          ],
          "properties": {
            "cwe": "CWE-79",
            "confidence": "HIGH",
            "snippet": "return Markup(request.args.get(\"html\", \"\"))"
          }
        },
        {
          "ruleId": "SAST-SSTI-001",
          "level": "error",
          "message": {
            "text": "Template() constructed from a dynamic string – SSTI risk."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_vuln_app.py"
                },
                "region": {
                  "startLine": 48,
                  "startColumn": 12
                }
              }
            }
          ],
          "properties": {
            "cwe": "CWE-1336",
            "confidence": "HIGH",
            "snippet": "return Template(\"Hello \" + user).render()"
          }
        },
        {
          "ruleId": "SAST-CMDI-001",
          "level": "error",
          "message": {
            "text": "os.system() invoked with a dynamically built command string – classic command injection sink."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_vuln_app.py"
                },
                "region": {
                  "startLine": 66,
                  "startColumn": 5
                }
              }
            }
          ],
          "properties": {
            "cwe": "CWE-78",
            "confidence": "HIGH",
            "snippet": "os.system(\"ping -c 1 \" + host)"
          }
        },
        {
          "ruleId": "SAST-CMDI-001",
          "level": "error",
          "message": {
            "text": "subprocess call with shell=True executes the command via the shell; combined with user input this enables command injection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_vuln_app.py"
                },
                "region": {
                  "startLine": 67,
                  "startColumn": 5
                }
              }
            }
          ],
          "properties": {
            "cwe": "CWE-78",
            "confidence": "HIGH",
            "snippet": "subprocess.run(f\"nslookup {host}\", shell=True)"
          }
        },
        {
          "ruleId": "SAST-DESERIAL-001",
          "level": "error",
          "message": {
            "text": "pickle.loads() deserializes arbitrary data; an attacker-controlled payload can lead to RCE."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_vuln_app.py"
                },
                "region": {
                  "startLine": 73,
                  "startColumn": 11
                }
              }
            }
          ],
          "properties": {
            "cwe": "CWE-502",
            "confidence": "HIGH",
            "snippet": "obj = pickle.loads(blob)"
          }
        },
        {
          "ruleId": "SAST-DESERIAL-001",
          "level": "error",
          "message": {
            "text": "yaml.load() without SafeLoader is unsafe; use yaml.safe_load() instead."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_vuln_app.py"
                },
                "region": {
                  "startLine": 74,
                  "startColumn": 11
                }
              }
            }
          ],
          "properties": {
            "cwe": "CWE-502",
            "confidence": "HIGH",
            "snippet": "cfg = yaml.load(request.data)"
          }
        },
        {
          "ruleId": "SAST-XXE-001",
          "level": "error",
          "message": {
            "text": "ElementTree.fromstring() from the stdlib does not protect against XXE; use defusedxml for untrusted XML."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_vuln_app.py"
                },
                "region": {
                  "startLine": 81,
                  "startColumn": 5
                }
              }
            }
          ],
          "properties": {
            "cwe": "CWE-611",
            "confidence": "MEDIUM",
            "snippet": "ElementTree.fromstring(blob)"
          }
        },
        {
          "ruleId": "SAST-XXE-001",
          "level": "error",
          "message": {
            "text": "lxml XMLParser created with resolve_entities=True; external entities will be expanded."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_vuln_app.py"
                },
                "region": {
                  "startLine": 82,
                  "startColumn": 14
                }
              }
            }
          ],
          "properties": {
            "cwe": "CWE-611",
            "confidence": "HIGH",
            "snippet": "parser = etree.XMLParser(resolve_entities=True)"
          }
        },
        {
          "ruleId": "SAST-XXE-001",
          "level": "error",
          "message": {
            "text": "etree.fromstring() from the stdlib does not protect against XXE; use defusedxml for untrusted XML."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_vuln_app.py"
                },
                "region": {
                  "startLine": 83,
                  "startColumn": 12
                }
              }
            }
          ],
          "properties": {
            "cwe": "CWE-611",
            "confidence": "MEDIUM",
            "snippet": "return etree.fromstring(blob, parser)"
          }
        }
      ]
    }
  ]
}